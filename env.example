# Copy to .env and fill in. Names = KISAN_ + field name in kisan/config.py.
# These localhost values are for running pytest on the laptop.
# Containers get service-name hosts from x-kisan-env in docker-compose.yml.

KISAN_ENV=local
KISAN_INFERENCE_BACKEND=fake
KISAN_ENABLED_STATES=RJ

KISAN_DATABASE_URL=postgresql+asyncpg://kisan:kisan@localhost:5432/kisan
KISAN_KAFKA_BOOTSTRAP=localhost:9092
KISAN_TEMPORAL_HOST=localhost:7233
KISAN_QDRANT_URL=http://localhost:6333

KISAN_S3_ENDPOINT=http://localhost:9000
KISAN_S3_PUBLIC_ENDPOINT=http://localhost:9000
KISAN_S3_BUCKET=kisan-animal-images
KISAN_S3_ACCESS_KEY=change-me        # = MINIO_ROOT_USER in docker-compose.yml
KISAN_S3_SECRET_KEY=change-me        # = MINIO_ROOT_PASSWORD in docker-compose.yml

KISAN_JWT_SECRET=change-me
